# Server (required in production)
GEMINI_API_KEY=

# Vercel Blob (auto-injected on Vercel when Blob store linked)
BLOB_READ_WRITE_TOKEN=

# Models (503/high demand → app retries + tries fallbacks automatically)
GEMINI_OCR_MODEL=gemini-2.0-flash
GEMINI_OCR_MODEL_FALLBACK=gemini-1.5-flash,gemini-2.5-flash
GEMINI_STRUCTURE_MODEL=gemini-2.0-flash
GEMINI_STRUCTURE_MODEL_FALLBACK=gemini-1.5-pro,gemini-2.5-pro

# Limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=50
JOB_TTL_HOURS=24

# Vercel KV / Upstash Redis (optional — in-memory fallback in development)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Client-visible limit (mirrors MAX_FILE_SIZE_MB)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25

# Optional: dispatch OCR to Inngest instead of Next.js after() — requires app/api/inngest/route.ts
USE_INNGEST=false

# Layout export v2 (default off until golden VAT invoice passes manually)
LAYOUT_EXPORT_V2=false
MAX_LAYOUT_VERIFY_RETRIES=2
NUMERIC_TOLERANCE_RATIO=0.02
RETRY_CROP_PADDING=0.05
REGION_LEFT_MAX=0.33
REGION_CENTER_MAX=0.66
