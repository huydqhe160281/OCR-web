# Server (required in production)
GEMINI_API_KEY=

# Vercel Blob (auto-injected on Vercel when Blob store linked)
BLOB_READ_WRITE_TOKEN=

# Models
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_STRUCTURE_MODEL=gemini-2.5-pro

# Limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=50
JOB_TTL_HOURS=24

# Vercel KV / Upstash Redis (optional — in-memory fallback in development)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Client-visible limit (mirrors MAX_FILE_SIZE_MB)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25

# Optional: dispatch OCR to Inngest instead of Next.js after() — requires app/api/inngest/route.ts
USE_INNGEST=false
